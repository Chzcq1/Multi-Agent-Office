# ═══════════════════════════════════════════════════════════════
#  AI Boardroom — ตัวแปร Environment ทั้งหมดที่ใช้ในโปรเจกต์
#
#  วิธีใช้:
#  • Vercel  → Project Settings → Environment Variables
#             ก๊อปปี้ชื่อตัวแปร (ซ้ายมือ) และใส่ค่า (ขวามือ)
#  • Replit  → Secrets panel (ไอคอนรูปกุญแจ)
#  • Local   → ก๊อปปี้ไฟล์นี้เป็น .env แล้วใส่ค่า
# ═══════════════════════════════════════════════════════════════


# ── 1. GitHub Models API (จำเป็น — ขาดไม่ได้) ──────────────────
#
#  ใช้สำหรับรัน AI agents ทั้ง 6 ตัว (gpt-4o-mini)
#  สร้างได้ที่: https://github.com/settings/tokens
#  Scope ที่ต้องการ: ไม่ต้องเลือก scope พิเศษ (Fine-grained token ก็ได้)
#
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
#
#  หมายเหตุ: ตัวแปรเดิมชื่อ GITHUB_PERSONAL_ACCESS_TOKEN ก็ยังรองรับ
#  แต่แนะนำให้ใช้ GITHUB_TOKEN (สั้นกว่า จำง่ายกว่า)


# ── 2. ฐานข้อมูล PostgreSQL (จำเป็นสำหรับบันทึกประวัติ) ────────
#
#  Vercel + Supabase (แนะนำ):
#   1. ไปที่ https://supabase.com → สร้าง project ใหม่
#   2. Project Settings → Database → Connection String
#   3. เลือก "Transaction" mode (port 6543) สำหรับ serverless
#   รูปแบบ: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#
#  Vercel + Neon (ทางเลือก ฟรี):
#   1. ไปที่ https://neon.tech → สร้าง project ใหม่
#   2. Dashboard → Connection Details → copy connection string
#
#  Replit: ระบบจะตั้งค่าให้อัตโนมัติ ไม่ต้องใส่เอง
#
DATABASE_URL=postgresql://user:password@host:5432/dbname
#
#  หลังจากตั้ง DATABASE_URL แล้ว ต้องสร้างตาราง DB ด้วยคำสั่ง:
#  (Vercel จะรันให้อัตโนมัติตอน deploy)
#  หรือรันเองด้วย: pnpm --filter @workspace/db run push-force


# ── 3. Supabase Auth + Credits (ไม่จำเป็น — เปิดใช้ได้ภายหลัง) ─
#
#  ถ้าต้องการระบบ Login / Credit ให้เพิ่มตัวแปรเหล่านี้
#  สร้างได้ที่: https://supabase.com → Project Settings → API
#
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxx

#  สำหรับ Frontend (ต้องขึ้นต้นด้วย VITE_ เพื่อให้ browser อ่านได้)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxx


# ── 4. Gemini AI (ไม่จำเป็น — สำหรับ /api/gemini/* routes) ────
#
#  สร้างได้ที่: https://aistudio.google.com/app/apikey
#
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxx

#  Replit AI Integrations proxy (ตั้งให้อัตโนมัติโดย Replit)
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=


# ── 5. ค่า Server (ไม่ต้องตั้งบน Vercel — ตั้งเองอัตโนมัติ) ────
#
NODE_ENV=production
PORT=8080
LOG_LEVEL=info
